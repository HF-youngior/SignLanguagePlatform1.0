<mxfile host="app.diagrams.net">
  <diagram name="AI识别翻译微服务架构-简洁版" id="architecture-simple">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 标题 -->
        <mxCell id="title" value="AI识别翻译微服务架构图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#1976D2" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        
        <!-- 前端层 -->
        <mxCell id="frontend-layer" value="前端层" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2196F3;fontSize=16;fontStyle=1;startSize=30;swimlaneFillColor=#FFFFFF;fontColor=#1976D2" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="400" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="translate-page" value="Vue.js 3 翻译页面" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2196F3;strokeColor=#1976D2;align=center;fontSize=12;fontStyle=1;fontColor=#FFFFFF" vertex="1" parent="frontend-layer">
          <mxGeometry x="20" y="40" width="360" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="input-methods" value="输入：图片/视频/摄像头/批量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2196F3;align=center;fontSize=11;fontColor=#1976D2" vertex="1" parent="frontend-layer">
          <mxGeometry x="20" y="110" width="170" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="result-display" value="结果展示：检测框/表格/统计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2196F3;strokeColor=#1976D2;align=center;fontSize=11;fontColor=#FFFFFF" vertex="1" parent="frontend-layer">
          <mxGeometry x="210" y="110" width="170" height="50" as="geometry" />
        </mxCell>
        
        <!-- API层 -->
        <mxCell id="api-layer" value="API服务层" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2196F3;fontSize=16;fontStyle=1;startSize=30;swimlaneFillColor=#FFFFFF;fontColor=#1976D2" vertex="1" parent="1">
          <mxGeometry x="520" y="80" width="400" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="flask-api" value="Flask RESTful API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2196F3;strokeColor=#1976D2;align=center;fontSize=12;fontStyle=1;fontColor=#FFFFFF" vertex="1" parent="api-layer">
          <mxGeometry x="20" y="40" width="360" height="50" as="geometry" />
