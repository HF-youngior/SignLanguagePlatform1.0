        <mxCell id="api-endpoints" value="接口：/detect/image | /detect/video | /detect/batch | /save/results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2196F3;align=center;fontSize=11;fontColor=#1976D2" vertex="1" parent="api-layer">
          <mxGeometry x="20" y="110" width="360" height="50" as="geometry" />
