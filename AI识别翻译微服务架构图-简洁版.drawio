        <mxCell id="arrow2" value="图像数据" style="endArrow=classic;html=1;rounded=0;strokeWidth=3;strokeColor=#2196F3;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#1976D2" edge="1" parent="1" source="api-endpoints" target="preprocess">
